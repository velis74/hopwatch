{
  "config": {
    "MD013": { "line_length": 120, "tables": false, "code_blocks": false },
    // Keep a Changelog repeats Added / Changed / Fixed under every version
    "MD024": { "siblings_only": true },
    // VitePress containers and embedded HTML
    "MD033": false,
    // VitePress builds heading anchors differently from markdownlint's GitHub slugs
    "MD051": false
  },
  "ignores": [".venv/**", "**/node_modules/**", "**/dist/**", "coverage/**", "docs/.vitepress/cache/**", "test-results/**", "playwright-report/**"]
}
